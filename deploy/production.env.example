# Production settings for docker-compose.prod.yml.
# Copy to .env.production in the repository root (git ignores it) and fill in every empty value:
#   cp deploy/production.env.example .env.production
# Generate secrets on the server, never reuse development values:
#   openssl rand -hex 32                        -> POSTGRES_PASSWORD, BIOMETRIC_VERIFY_TOKEN
#   openssl rand -base64 64 | tr -d '\n'        -> JWT_SECRET
#   openssl rand -base64 32                     -> FILE_ENCRYPTION_KEY (must stay the same forever:
#                                                  losing it makes every stored file unreadable)

# --- Domain and HTTPS ---
# Public domain for the app; its DNS A/AAAA record must point at this server. The API is served at /api.
APP_DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=

# --- Database (internal only, never published) ---
POSTGRES_DB=gaint_interns
POSTGRES_USER=gaint
# Use hex (openssl rand -hex 32): it is placed inside the database URL, so avoid @ : / ? # characters.
POSTGRES_PASSWORD=

# --- Sign-in tokens ---
JWT_SECRET=
JWT_PREVIOUS_SECRETS=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Staff MFA (authenticator app) ---
# Production MUST use false: test code 000000 bypasses authenticator-app verification.
# Use a separate isolated test environment if test MFA is needed.
ALLOW_TEST_MFA_CODE=false

# --- First Super Admin (created on first start) ---
INITIAL_ADMIN_EMAIL=
# At least 12 characters and not the development default.
INITIAL_ADMIN_PASSWORD=

# --- File encryption ---
FILE_ENCRYPTION_KEY=
FILE_ENCRYPTION_KEY_ID=2026-pq-1
FILE_ENCRYPTION_PREVIOUS_KEYS=

# --- Private object storage (AWS S3 or any S3-compatible service) ---
S3_BUCKET=
S3_REGION=
# Leave empty for AWS. For other providers set their HTTPS endpoint (for example Cloudflare R2).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Face attendance (verifier runs as a private container) ---
BIOMETRIC_VERIFY_TOKEN=
BIOMETRIC_MATCH_THRESHOLD=0.6
# Empty = record anti-spoof scores without rejecting. Set (0-1) only after calibrating on real captures.
BIOMETRIC_ANTISPOOF_THRESHOLD=

# --- Retention and behaviour ---
PROOF_RETENTION_DAYS=365
FACE_RETENTION_DAYS=90
APP_TIMEZONE=Asia/Kolkata
ATTENDANCE_MAX_RETRIES=
AUTH_RATE_LIMIT=

# --- Optional: AI question generation ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_GENERATION_QUESTIONS=30
AI_GENERATION_RATE_LIMIT=20
