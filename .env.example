NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5434/gaint_interns
# Optional Docker-only override (use this for a managed production database).
# BACKEND_DATABASE_URL=postgres://postgres:postgres@db:5432/gaint_interns
# Production requires at least 64 random bytes: openssl rand -base64 64
JWT_SECRET=development-only-change-me
# Optional staged rotation: comma-separated old secrets remain verification-only.
JWT_PREVIOUS_SECRETS=
# Optional token claims. Set these before issuing production tokens and keep them stable.
JWT_ISSUER=
JWT_AUDIENCE=
# New tokens carry both HS256 and NIST ML-DSA-65 signatures. Keep false only
# during a short deployment window if already-issued legacy JWTs must survive.
PQ_REQUIRE_HYBRID_TOKENS=true
PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Initial bootstrap account. Production requires a unique password of at least 12 characters.
INITIAL_ADMIN_EMAIL=gaintclout@gmail.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Local day boundaries for attendance and reminders
APP_TIMEZONE=Asia/Kolkata
# Face-match retries before an attendance exception is created
ATTENDANCE_MAX_RETRIES=3
# Development prototype only. Production must use an approved HTTPS verifier service.
BIOMETRIC_VERIFY_URL=http://127.0.0.1:8765/verify
BIOMETRIC_VERIFY_TOKEN=
# Anti-spoof enforcement for face attendance (0-1). Leave empty to record scores without rejecting.
# Choose a value only after reviewing attendance_events.liveness_score from real captures.
BIOMETRIC_ANTISPOOF_THRESHOLD=

# Required in production: derives the ML-KEM-768 keypair used to establish a
# fresh AES-256-GCM content key for every protected file.
# Generate with: openssl rand -base64 32. Keep it safe: losing it makes those files unreadable.
FILE_ENCRYPTION_KEY=
# Non-secret identifier written into newly encrypted files. Change it when rotating the key.
FILE_ENCRYPTION_KEY_ID=primary
# JSON object of old key ids to base64 keys, retained only while old files still use them.
# Example: {"2026-q3":"base64-encoded-32-byte-key"}
FILE_ENCRYPTION_PREVIOUS_KEYS=

# Production file storage. Keep the bucket private and grant the backend workload identity only
# the required GetObject/PutObject/DeleteObject permissions. Do not put AWS keys in this file.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# Optional for MinIO or another S3-compatible service. Leave blank for AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional AWS KMS key ARN/id. Without it, objects use S3-managed AES-256 encryption.
S3_KMS_KEY_ID=

# Email for applicant decisions, password resets and college reports. Without SMTP, nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Required in production. Once set, uploads fail if the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Required in production: days after the internship ends.
PROOF_RETENTION_DAYS=
FACE_RETENTION_DAYS=

# Credential attempts allowed per IP per 15 minutes; raise it if a whole campus shares one IP
AUTH_RATE_LIMIT=300

# Groq Cloud AI for Admin-only Initial Assessment MCQ generation.
# Create a key at https://console.groq.com/keys and choose a model listed by the Groq /models API.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_GENERATION_QUESTIONS=30
# Authenticated generation requests allowed per Admin IP per 15 minutes.
AI_GENERATION_RATE_LIMIT=20
