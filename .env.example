NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5434/gaint_interns
# Production requires at least 64 random bytes: openssl rand -base64 64
JWT_SECRET=development-only-change-me
PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Local day boundaries for attendance and reminders
APP_TIMEZONE=Asia/Kolkata
# Face-match retries before an attendance exception is created
ATTENDANCE_MAX_RETRIES=3
# Development prototype only. Production must use an approved HTTPS verifier service.
BIOMETRIC_VERIFY_URL=http://127.0.0.1:8765/verify
BIOMETRIC_VERIFY_TOKEN=

# Required in production: encrypts college proofs, face images and attendance evidence at rest.
# Generate with: openssl rand -base64 32. Keep it safe: losing it makes those files unreadable.
FILE_ENCRYPTION_KEY=

# Email for applicant decisions, password resets and college reports. Without SMTP, nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Required in production. Once set, uploads fail if the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Required in production: days after the internship ends.
PROOF_RETENTION_DAYS=
FACE_RETENTION_DAYS=

# Credential attempts allowed per IP per 15 minutes; raise it if a whole campus shares one IP
AUTH_RATE_LIMIT=300

# Groq Cloud AI for Admin-only Initial Assessment MCQ generation.
# Create a key at https://console.groq.com/keys and choose a model listed by the Groq /models API.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_GENERATION_QUESTIONS=30
# Authenticated generation requests allowed per Admin IP per 15 minutes.
AI_GENERATION_RATE_LIMIT=20
