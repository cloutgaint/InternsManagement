DATABASE_URL=postgres://postgres:postgres@localhost:5434/gaint_interns
JWT_SECRET=replace-with-64-byte-random-secret
PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Local day boundaries for attendance and reminders
APP_TIMEZONE=Asia/Kolkata
# Face-match retries before an attendance exception is created
ATTENDANCE_MAX_RETRIES=3

# Required in production: encrypts college proofs, face images and attendance evidence at rest.
# Generate with: openssl rand -base64 32. Keep it safe: losing it makes those files unreadable.
FILE_ENCRYPTION_KEY=

# Email for applicant decisions, password resets and college reports. Without SMTP, nothing is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional ClamAV scanning of proof uploads. Once set, uploads fail if the scanner is unreachable.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Automatic deletion is off until GAINT sets its retention periods (days after the internship ends)
PROOF_RETENTION_DAYS=
FACE_RETENTION_DAYS=

# Credential attempts allowed per IP per 15 minutes; raise it if a whole campus shares one IP
AUTH_RATE_LIMIT=300
